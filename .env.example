# Copy to .env and fill in. Never commit .env.
# Placeholders only — never put real keys/addresses here.

# --- x402 payment recipient (required) ---
PAYTO_EVM=0xYOUR_BASE_ADDRESS_HERE

# --- Network: base-sepolia (testnet, default) or base (mainnet, real money) ---
NETWORK=base-sepolia

# Testnet facilitator (no auth). Ignored on mainnet.
FACILITATOR_URL=https://x402.org/facilitator
# Mainnet CDP facilitator credentials (REQUIRED when NETWORK=base).
# Free account at https://portal.cdp.coinbase.com
CDP_API_KEY_ID=your_cdp_api_key_id_here
CDP_API_KEY_SECRET=your_cdp_api_key_secret_here

# --- Pricing (flat USDC per request, one env var per route) ---
# Defaults are 80% of api-xpay.com's prices; set these to override.
PRICE_PING_USDC=0.004
PRICE_STATUS_USDC=0.004
PRICE_TIME_USDC=0.004
PRICE_UUID_USDC=0.004
PRICE_RANDOM_USDC=0.004
PRICE_IP_USDC=0.004
PRICE_NETWORK_USDC=0.004
PRICE_ECHO_USDC=0.004
PRICE_HASH_USDC=0.004
PRICE_KECCAK_USDC=0.004
PRICE_BASE64_USDC=0.004
PRICE_SLUG_USDC=0.004
PRICE_WORDCOUNT_USDC=0.004
PRICE_PAYMENT_USDC=0.004
PRICE_QUOTE_USDC=0.004
PRICE_SUMMARIZE_USDC=0.008
PRICE_REWRITE_USDC=8
PRICE_SENTIMENT_USDC=8
PRICE_KEYWORDS_USDC=8
PRICE_CLASSIFY_USDC=16
PRICE_OUTLINE_USDC=16

# --- AI backend (REQUIRED for the 6 AI routes; boot warns if unset) ---
# Any OpenAI-compatible endpoint works: OpenAI, OpenRouter, vLLM, Ollama, ...
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000

# --- Limits (all overridable, no code change needed) ---
MAX_TEXT_CHARS=20000
MAX_BODY_BYTES=262144

# --- Rate limits (per minute, per IP) ---
FREE_RATE_LIMIT_PER_MIN=60
PAYER_RATE_LIMIT_PER_MIN=120

# --- Server ---
PORT=8788
HOST=0.0.0.0
# Public origin used in /openapi.json servers, /sitemap.xml, and the 402
# resource URLs. On Railway set this to https://aiutilities.combify.app
PUBLIC_BASE_URL=https://aiutilities.combify.app
